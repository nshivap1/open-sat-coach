{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open SAT Coach",
  "version": "0.1.0",
  "identifier": "org.opensatcoach.desktop",
  "build": {
    "frontendDist": "../dist-desktop",
    "beforeBuildCommand": "npm run build:desktop",
    "beforeDevCommand": {
      "script": "npm run build:desktop",
      "wait": true
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Open SAT Coach",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["binaries/*"],
    "category": "Education",
    "shortDescription": "Offline SAT practice with an optional local AI coach",
    "longDescription": "Open SAT Coach is an offline SAT practice app. Your progress stays on this computer, and the optional AI coach runs on a local model (llama.cpp, Ollama or LM Studio).",
    "copyright": "",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
